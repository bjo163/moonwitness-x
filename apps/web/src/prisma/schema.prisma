datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==============================================================================
// 🌌 CELESTIAL OPERATING SYSTEM ORM MODELS
// ==============================================================================

model ObservationStation {
  id           String             @id @default(cuid())
  name         String
  code         String             @unique
  latitude     Float
  longitude    Float
  elevation    Float              @default(0) // meters
  country      String
  city         String
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  observations HilalObservation[]
}

model HilalObservation {
  id                 String             @id @default(cuid())
  stationId          String
  station            ObservationStation @relation(fields: [stationId], references: [id])
  observationDate    DateTime
  sunsetUtc          DateTime
  moonAltitude       Float // degrees
  elongation         Float // degrees
  crescentWidthArcmin Float?
  crescentSighted    Boolean            @default(false)
  mabimsPassed       Boolean            @default(false)
  wujudulHilalPassed Boolean            @default(false)
  odehZone           String? // A, B, C, D
  opticalInstrument  String? // Naked Eye, Telescope, etc.
  observerName       String
  notes              String?
  imageUrl           String?
  verified           Boolean            @default(false)
  createdAt          DateTime           @default(now())
}

model CelestialEvent {
  id           String   @id @default(cuid())
  eventType    String // CONJUNCTION, SOLAR_ECLIPSE, LUNAR_ECLIPSE, EQUINOX, SOLSTICE
  eventDateUtc DateTime
  julianDay    Float
  title        String
  description  String?
  metadataJson String? // Ephemeris technical JSON
  createdAt    DateTime @default(now())
}

model CosmicScriptureConcordance {
  id               String   @id @default(cuid())
  scripture        String // TAURAT, ZABUR, INJIL, QURAN
  reference        String // e.g. QS 32:5, Psalm 90:4, Genesis 1:14
  originalText     String?
  translation      String
  cosmicTopic      String // SPEED_OF_LIGHT, FLRW_EXPANSION, DIVINE_TIME_DILATION, etc.
  scientificValue  String?
  correlationRatio Float?
  createdAt        DateTime @default(now())
}

model CelestialSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

